# Wavespeed — one API key for Seedance 2.0, Nano Banana 2, ElevenLabs, more
# Get yours at: https://wavespeed.ai
WAVESPEED_API_KEY=wsp_your_wavespeed_key_here

# Gemini — video understanding for the ad-clone-analyzer skill
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Scrape Creators — pulls reference ads from the Meta Ad Library by URL or page ID.
# Required if you want to clone ads directly from Facebook/Instagram Ad Library.
# If you only ever pass local mp4 files or YouTube URLs to the skill, you can skip this.
# Get a key at: https://scrapecreators.com
SCRAPE_CREATORS_API=your_scrapecreators_key_here
